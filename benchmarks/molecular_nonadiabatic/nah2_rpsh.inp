# RPSH starts on centroid adiabatic eigenstate 1, a different electronic
# preparation from the focused diabatic state in nah2_nrpmd.inp.
task = "nonadiabatic"
method = "rpsh"
beta = 1000.0
beads = 4
seed = 20261101

[model]
name = "nah2_leps_5g_1992"

[system]
symbols = ["Na", "H", "H"]
masses = ["22.98976928 amu", "1.00782503223 amu", "1.00782503223 amu"]
positions = [[3.2, 0.8, 0.0], [-0.85, 0.0, 0.0], [0.85, 0.0, 0.0]]

[initial]
kind = "point"
active_surface = 1
momenta = [[-7.974223120067328, -1.993555780016832, 0.0], [3.987111560033664, 0.996777890008416, 0.0], [3.987111560033664, 0.996777890008416, 0.0]]

[ensemble]
trajectories = 8
steps = 100
sample_stride = 10

[dynamics]
dt = "0.2 autime"
native = false
block_steps = 32
rescaling = "ring"
electronic_substeps = 8
decoherence = "none"

[output]
directory = "runs/nah2-rpsh"
