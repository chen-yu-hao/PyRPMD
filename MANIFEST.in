include README.md LICENSE THIRD_PARTY_NOTICES.md
include pyproject.toml setup.py
include native/CMakeLists.txt native/README.md native/ABI.md
recursive-include native *.cpp *.h *.c
recursive-include docs *.md
recursive-include examples *.inp *.toml *.py *.xyz *.json *.md *.slurm
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] *.so *.o
