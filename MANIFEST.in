include README.md README.zh-CN.md LICENSE THIRD_PARTY_NOTICES.md
include pyproject.toml setup.py
recursive-include packaging *.yaml *.md *.py
include native/CMakeLists.txt native/README.md native/ABI.md native/thermal-NOTICE.md
include native/onnx/CMakeLists.txt native/onnx/README.md
include tools/export_jaxpip_onnx.py tools/requirements-jaxpip-export.txt
include tools/data_manifest.py
include tools/check_workflow_policy.py
include tools/campaign_launch.py
recursive-include native *.cpp *.h *.hpp *.c
recursive-include docs *.md *.json *.csv *.png *.pdf *.py *.css *.txt *.html *.npz *.xml *.log
exclude docs/validation/tier1-2026-10-31/*.npz
prune docs/_build
recursive-include examples *.inp *.toml *.py *.xyz *.json *.md *.slurm
include examples/analysis/reference-rates.csv
recursive-include tests *.py
recursive-include tests/data *.json
include benchmarks/h3/*.py benchmarks/h3/*.md benchmarks/h3/*.f90 benchmarks/h3/*.inp benchmarks/h3/source.json
include benchmarks/h3/diatomic_switch.cpp
recursive-include benchmarks/h3/convergence_inputs *.inp
recursive-include benchmarks/h3/reproduction_results *.md *.json *.csv *.svg
recursive-include benchmarks/h3/preparation_results *.md *.json *.csv *.svg
recursive-include benchmarks/hho2 *.py *.md
recursive-include benchmarks/brhcl *.py *.md *.json *.cpp *.f90 *.map
prune benchmarks/brhcl/build
recursive-include benchmarks/fes_methods *.py *.md *.c
include benchmarks/pmf_accuracy/render_validation.py
recursive-include benchmarks/loop_native *.py *.md *.c *.cpp *.h *.f90
recursive-include benchmarks/materials *.py *.md *.json
recursive-include benchmarks/condensed_phase *.py *.cpp *.md *.json *.txt *.png *.pdf
# Raw observations are public in Git and also supplied in the review archive.
# Keep raw CSV/NPZ files out of the Python sdist to control package size.
recursive-exclude benchmarks/condensed_phase/results *.csv *.npz
recursive-include benchmarks/efficiency *.py *.md
recursive-include benchmarks/surface *.py *.md
include benchmarks/batched_dynamics.py benchmarks/rpc_mts.py benchmarks/tier1_recrossing.py
recursive-include benchmarks/trpmd *.py *.json
recursive-include benchmarks/published_rates *.py *.json *.md
recursive-include benchmarks/transition_state_search *.py *.md
recursive-include benchmarks/water *.py *.json *.md
recursive-include benchmarks/literature *.py *.json *.md
include benchmarks/efficiency/native-ensembles-summary.json
include benchmarks/efficiency/propagation_stack_batching.json
recursive-include benchmarks/analysis_reports *.py *.md
recursive-include benchmarks/nonadiabatic *.py *.md *.json
recursive-include benchmarks/molecular_nonadiabatic *.py *.md *.json *.inp *.f
include benchmarks/molecular_nonadiabatic/vendor/chempotpy/LICENSE
recursive-include src/pyrpmd/potentials/_licenses *.txt
recursive-include benchmarks/tier2_literature *.py *.md
recursive-include docs/validation/pr63-independent-review *.pt
recursive-include docs/validation/tier2-literature-2026-11-01 *.svg *.jsonl *.pt *.py.gz
# Exclude local restart caches; explicitly retain unique raw sampling evidence.
recursive-exclude docs/validation/tier2-literature-2026-11-01 *.npz
recursive-include docs/validation/tier2-literature-2026-11-01/sampling/opes_v2 trajectory.npz
recursive-include docs/validation/tier2-literature-2026-11-01/sampling/opes_before_initialization_fix trajectory.npz
include docs/validation/tier2-literature-2026-11-01/sampling/shared_metadynamics/seed_*.npz
include docs/validation/tier2-literature-2026-11-01/sampling/replica_exchange/raw_moments.npz
include docs/validation/tier2-literature-2026-11-01/sampling/ml_lifecycle/training_and_heldout.npz
recursive-include docs/validation/tier2-literature-2026-11-01/sampling/plumed_comparator *.dat *_KERNELS
recursive-include docs/validation/tier2-literature-2026-11-01/sampling/plumed_comparator_before_initialization_fix *.dat *_KERNELS
prune docs/validation/tier2-literature-2026-11-01/sampling/opes
recursive-exclude docs/validation/tier2-literature-2026-11-01/sampling bck.*
global-exclude __pycache__ *.py[cod] *.so *.o

recursive-include src/pyrpmd/pesgen/_native *.cpp *.f90 *.h
recursive-include src/pyrpmd/templates *.inp

# Torch validation tests import these independent reference harnesses.
include benchmarks/torch_device_backend.py benchmarks/torch_paper_validation.py benchmarks/torch_observable_validation.py
recursive-include benchmarks/torch_literature *.md *.json *.gz

include benchmarks/torch_bcocb_validation.py

include benchmarks/rpmdrate_normal_modes.py benchmarks/rpmdrate_normal_modes_validation.py

include benchmarks/mixed_sampling_validation.py

# Existing paper regressions require their checked-in reference files in source archives.
include benchmarks/paper_validation/dac_spin_statistical.py benchmarks/paper_validation/dac_p*_liu2024_reference.csv

recursive-include examples/nonadiabatic/data *.csv

# Shared native RPMDrate coordinate/quantum-flux reproducibility example.
recursive-include benchmarks/shared_rate_quantum *.py *.md *.json
