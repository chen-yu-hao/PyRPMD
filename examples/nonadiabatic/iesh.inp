schema_version = 1
task = "nonadiabatic"
method = "iesh"
beads = 1
beta = 100.0
seed = 1201
description = "Small spinless Newns-Anderson IESH example; finite band, P=1, no convergence claim."

[model]
name = "newns_anderson"

[model.params]
nband = 12
band_min = -0.25
band_max = 0.25
chemical_potential = 0.0
discretization = "gauss-legendre"
level_energy = 0.0
level_slope = 0.02
hybridization = 0.05
hybridization_slope = 0.0
bare_force_constant = 0.001
center = 0.0

[system]
masses = [2000.0]
positions = [[-0.5, 0.0, 0.0]]

[initial]
kind = "point"
momenta = [[20.0, 0.0, 0.0]]
occupied = [0, 1, 2, 3, 4, 5]

[dynamics]
dt = 0.5
native = false
nelectrons = 6
electronic_substeps = 4
max_hop_probability = 0.2
gap_tolerance = 1e-10
block_steps = 25

[ensemble]
trajectories = 8
steps = 100
sample_stride = 5

[parallel]
trajectory_workers = 1
threads = 1

[output]
directory = "runs/iesh"
