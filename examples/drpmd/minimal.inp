# Minimal chemical input: two reactants, radial separation, and the PES.
# Pilot defaults infer geometric candidate labels and withhold chemical rates.
# This V=0 model only tests mechanics; it does not describe a chemical reaction.
task = "drpmd"

[system]
reactants = ["reactant_a.xyz", "reactant_b.xyz"]
separation = "3 angstrom"

[potential]
provider = "free"
