# Two-dimensional VES demonstration. PyRPMD injects MULTIPLE_WALKERS into the
# optimizer; do not add it manually.
UNITS LENGTH=Bohr ENERGY=Ha TIME=atomic
p: POSITION ATOM=1

bx: BF_LEGENDRE ORDER=10 MINIMUM=-2.0 MAXIMUM=2.0
by: BF_LEGENDRE ORDER=8 MINIMUM=-1.5 MAXIMUM=1.5
wt: TD_WELLTEMPERED BIASFACTOR=8

v: VES_LINEAR_EXPANSION ...
  ARG=p.x,p.y
  BASIS_FUNCTIONS=bx,by
  TARGET_DISTRIBUTION=wt
  TEMP=300
  GRID_BINS=80,60
... VES_LINEAR_EXPANSION

opt: OPT_AVERAGED_SGD ...
  BIAS=v
  STRIDE=20
  STEPSIZE=0.05
  COEFFS_FILE=coefficients.data
  COEFFS_OUTPUT=5
  FES_OUTPUT=10
  TARGETDIST_STRIDE=5
  TARGETDIST_OUTPUT=10
... OPT_AVERAGED_SGD

PRINT ARG=p.x,p.y,v.bias STRIDE=10 FILE=COLVAR
