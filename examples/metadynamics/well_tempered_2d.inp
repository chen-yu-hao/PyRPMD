# Independent WT metadynamics replicas. Their hills are never combined.
task = "metadynamics"
temperature = "300 K"
beads = 4
seed = 719

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]

[potential]
provider = "builtin"
name = "harmonic"
params = {k = 0.002}

[dynamics]
timestep = "0.1 fs"

[sampling]
equilibration_steps = 100
production_steps = 600
sample_interval = 5
andersen_interval = 40
replicas = 2

[[cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"

[[cvs]]
name = "y"
kind = "cartesian"
atom = 0
axis = "y"
estimator = "bead_average"

[metadynamics]
cvs = ["x", "y"]
mode = "well_tempered"
sigma = ["0.25 bohr", "0.25 bohr"]
height = "0.02 kcal/mol"
pace = 20
bias_factor = 8.0

[analysis]
method = "bias_estimate"
bins = [24, 24]
ranges = [[-2.0, 2.0], [-2.0, 2.0]]
bootstrap = 0

[output]
directory = "runs/meta_well_tempered_2d"
checkpoint_steps = 100
