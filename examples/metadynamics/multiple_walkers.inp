# Shared-bias WT metadynamics: synchronize hills after each 100-step block.
# This short run demonstrates restart and output, not converged free energy.
task = "fes"
temperature = "300 K"
beads = 4
seed = 719

[fes]
method = "metadynamics"

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]

[potential]
provider = "builtin"
name = "harmonic"
params = {k = 0.002}

[dynamics]
timestep = "0.1 fs"

[fes.sampling]
equilibration_steps = 100
production_steps = 600
sample_interval = 5
andersen_interval = 40
replicas = 3

[[fes.cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"

[[fes.cvs]]
name = "y"
kind = "cartesian"
atom = 0
axis = "y"
estimator = "bead_average"

[fes.metadynamics]
cvs = ["x", "y"]
mode = "well_tempered"
sigma = ["0.25 bohr", "0.25 bohr"]
height = "0.02 kcal/mol"
pace = 20
bias_factor = 8.0
multiple_walkers = true
block_steps = 100

[fes.analysis]
method = "bias_estimate"
bins = [24, 24]
ranges = [[-2.0, 2.0], [-2.0, 2.0]]
bootstrap = 0

[output]
directory = "runs/meta_multiple_walkers"
checkpoint_steps = 100
