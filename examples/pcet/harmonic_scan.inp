# Artificial one-proton PCET model, not fitted to any molecule or electrode.
# The two harmonic force constants are different, so H/D changes both
# vibrational overlaps and the oxidized/reduced proton partition functions.
task = "pcet"
temperature = ["250 K", "300 K", "350 K"]

[pcet]
method = "golden_rule"
normalization = "local_first_order"
isotopes = ["H", "D"]
# Reduced minus oxidized free energy at the minima, at the reference voltage.
# This excludes the transferring proton's zero-point and thermal vibrational
# free energy; the proton eigensolver supplies those contributions.
driving_force = "0.0 eV"
reorganization_energy = "0.7 eV"
electronic_coupling = "0.001 eV"

[pcet.electrode]
model = "wide_band"
density_of_states = "1 eV^-1"
# Reference labels are recorded, not converted automatically.
potential_reference = "SHE"
reference_potential_V = 0.0
potentials_V = [-0.2, 0.0, 0.2]

[pcet.proton]
grid_min = "-1.5 angstrom"
grid_max = "1.5 angstrom"
grid_points = 401
states = 12

[pcet.proton.oxidized]
kind = "harmonic"
center = "-0.2 angstrom"
force_constant = "4 eV/angstrom^2"

[pcet.proton.reduced]
kind = "harmonic"
center = "0.2 angstrom"
force_constant = "5 eV/angstrom^2"

[pcet.numerics]
quadrature_rtol = 1e-9
quadrature_atol = 1e-11
convergence_check = true
relative_tolerance = 0.01
absolute_tolerance_s = 1e-12

[output]
directory = "runs/pcet-harmonic"
