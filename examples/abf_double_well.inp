# Illustrative model only; scan timestep, bin width and independent histories.
task = "fes"
temperature = "157887.5124020334 K"
beads = 1
seed = 117

[system]
symbols = ["H"]
masses = [1.0]
geometry = [[-1.0, 0.0, 0.0]]
geometry_unit = "bohr"

[potential]
provider = "builtin"
name = "double_well"
[potential.params]
height = 1.0
width = 1.0
confinement = 1.0

[dynamics]
timestep = "0.03 autime"

[output]
checkpoint_steps = 1000

[fes]
method = "abf"
[[fes.cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"

[fes.abf]
cvs = ["x"]
ranges_au = [[-1.5, 1.5]]
bins = [40]
full_samples = 50
pace = 50
wall_stiffness_au = [20.0]
derivative = "analytic"

[fes.sampling]
equilibration_steps = 500
production_steps = 10000
sample_interval = 10
replicas = 3
thermostat = "pile-l"
gamma_centroid = "1 autime^-1"

[fes.analysis]
method = "mean_force"
min_count = 10
bootstrap = 0
