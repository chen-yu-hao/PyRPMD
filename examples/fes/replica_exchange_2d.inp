# Short PILE-L / REUS teaching model; not a physical convergence claim.
task = "fes"
preset = "pilot"
temperature = "300 K"
beads = 4
seed = 8301

[system]
symbols = ["H"]
masses = [1837.152647]
geometry = [[0.0, 0.0, 0.0]]

[potential]
provider = "builtin"
name = "harmonic"
params = {k = 0.002}

[dynamics]
timestep = "0.1 fs"

[sampling]
equilibration = "20 fs"
production = "100 fs"
interval = "0.2 fs"
thermostat = "pile-l"
gamma_centroid = "0.02 fs^-1"
replicas = 2

[[cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"
unit = "bohr"

[[cvs]]
name = "y"
kind = "cartesian"
atom = 0
axis = "y"
estimator = "centroid"
unit = "bohr"

[umbrella]
cvs = ["x", "y"]
grid = [{start = -0.5, stop = 0.5, count = 3}, {start = -0.5, stop = 0.5, count = 3}]
stiffness = ["0.004 hartree/bohr^2", "0.004 hartree/bohr^2"]

[replica_exchange]
enabled = true
interval_steps = 50
pairs = [[0,1], [1,2], [3,4], [4,5], [6,7], [7,8], [0,3], [3,6], [1,4], [4,7], [2,5], [5,8]]

[analysis]
bins = [16, 16]
ranges = [[-1.5, 1.5], [-1.5, 1.5]]
bootstrap = 10
min_count = 2

[output]
directory = "runs/replica_exchange_2d"
checkpoint_interval = "10 fs"
