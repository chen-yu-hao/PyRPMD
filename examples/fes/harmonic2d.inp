# A two-dimensional centroid free-energy surface in a harmonic test model.
task = "fes"
preset = "pilot"
temperature = "300 K"
beads = 4
seed = 73

[system]
symbols = ["H"]
masses = [1837.152647]
geometry = [[0.0, 0.0, 0.0]]

[potential]
provider = "builtin"
name = "harmonic"
params = {k = 0.002}

[dynamics]
timestep = "0.1 fs"

[sampling]
equilibration = "10 fs"
production = "40 fs"
interval = "0.2 fs"
andersen_interval = 40
replicas = 2

[[cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"
unit = "bohr"

[[cvs]]
name = "y"
kind = "cartesian"
atom = 0
axis = "y"
estimator = "centroid"
unit = "bohr"

[umbrella]
cvs = ["x", "y"]
grid = [{start = -1.0, stop = 1.0, count = 3}, {start = -1.0, stop = 1.0, count = 3}]
stiffness = ["0.01 hartree/bohr^2", "0.01 hartree/bohr^2"]

[analysis]
bins = [16, 16]
ranges = [[-2.0, 2.0], [-2.0, 2.0]]
bootstrap = 20
min_count = 2

[output]
directory = "runs/harmonic2d"
checkpoint_interval = "10 fs"
