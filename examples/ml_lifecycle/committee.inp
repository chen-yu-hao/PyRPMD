# Analytic committee pilot: candidates are model predictions, not QM labels.
task = "pimd"
temperature = "300 K"
beads = 4
seed = 219

[system]
symbols = ["H"]
geometry = [[0.5, 0.0, 0.0]]
geometry_unit = "bohr"

[potential]
provider = "committee"

[[potential.members]]
provider = "builtin"
name = "harmonic"
params = {k = 0.002}

[[potential.members]]
provider = "builtin"
name = "harmonic"
params = {k = 0.0024}

[dynamics]
timestep = "0.1 fs"
loop_backend = "python"

[sampling]
equilibration_steps = 20
production_steps = 80
sample_interval = 4
replicas = 2
thermostat = "pile-l"

[active_learning]
interval_steps = 5
force_threshold = "0.00005 hartree/bohr"
max_frames = 32
directory = "active_learning"

[output]
directory = "runs/committee"
checkpoint_steps = 20
