# Short provider/CLI smoke example; not a converged molecular calculation.
task = "pimd"
temperature = "300 K"
beads = 4
seed = 713

[system]
symbols = ["H", "H"]
geometry = [[0, 0, 0], [0.74, 0, 0]]
geometry_unit = "angstrom"

[potential]
provider = "openmm"
factory = "openmm_harmonic.py:build_system"
params = {platform = "Reference"}

[dynamics]
timestep = "0.1 fs"

[sampling]
thermostat = "pile-l"
equilibration = "1 fs"
production = "2 fs"
interval = "0.2 fs"
replicas = 1

[output]
directory = "runs/openmm-harmonic"
