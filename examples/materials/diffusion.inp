# Periodic free-particle negative control: MSD is ballistic, not diffusive.
# A successful run should withhold D and report ballistic_or_drifting.
task = "diffusion"
preset = "pilot"
temperature = "300 K"
beads = 8
seed = 682

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
geometry_unit = "angstrom"
cell = [[2.5, 0.0, 0.0], [0.0, 2.5, 0.0], [0.0, 0.0, 12.0]]
cell_unit = "angstrom"
pbc = [true, true, false]

[potential]
provider = "free"

[dynamics]
integrator = "cayley-bcb"
timestep = "0.1 fs"

[sampling]
thermostat = "pile-l"
equilibration = "20 fs"
# Production is unthermostatted RPMD, with physical atomic masses.
production = "80 fs"
interval = "0.5 fs"
replicas = 4

[diffusion]
atom_indices = [0]
axes = [0, 1]
max_lag = 40
fit_range = ["10 fs", "20 fs"]
bootstrap = 100

[output]
directory = "runs/materials-diffusion"
checkpoint_interval = "10 fs"
