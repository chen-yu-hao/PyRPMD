# Fixed-cell analytic validation model, not a fitted material potential.
task = "pimd"
preset = "pilot"
temperature = "300 K"
beads = 8
seed = 681

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
geometry_unit = "angstrom"
cell = [[2.5, 0.0, 0.0], [0.0, 2.5, 0.0], [0.0, 0.0, 12.0]]
cell_unit = "angstrom"
pbc = [true, true, false]

[potential]
provider = "builtin"
name = "periodic_cosine"
# Heights in hartree; transverse harmonic confinement in hartree/bohr^2.
params = {height = [0.004, 0.004, 0.0], confinement = 0.01}

[dynamics]
integrator = "cayley-bcb"
timestep = "0.1 fs"

[sampling]
thermostat = "pile-l"
gamma_centroid = "0.01 fs^-1"
equilibration = "20 fs"
production = "80 fs"
interval = "0.5 fs"
replicas = 2

[output]
directory = "runs/materials-pimd"
checkpoint_interval = "10 fs"
