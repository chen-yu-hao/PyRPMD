# Directed single-site escape in an analytic periodic potential.
# This is a workflow pilot; neither PMF nor recrossing is converged.
task = "site_rate"
preset = "pilot"
temperature = "300 K"
beads = 4
seed = 683

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
cell = [[4.0, 0.0, 0.0], [0.0, 8.0, 0.0], [0.0, 0.0, 8.0]]
pbc = [true, false, false]

[potential]
provider = "builtin"
name = "periodic_cosine"
params = {height = [0.002, 0.0, 0.0], confinement = 0.01}

[dynamics]
timestep = "0.1 fs"

[sampling]
thermostat = "andersen"
equilibration = "50 fs"
production = "200 fs"
interval = "0.5 fs"
andersen_interval = 50
replicas = 2

[[cvs]]
name = "site_x"
kind = "fractional"
atom = 0
axis = "x"
estimator = "centroid"

[umbrella]
cvs = ["site_x"]
centers = [-0.6, -0.4, -0.2, 0.0, 0.2, 0.4, 0.6]
stiffness = 0.10

[analysis]
bins = 32
ranges = [[-0.8, 0.8]]
min_count = 1
bootstrap = 0

[site_rate]
cv = "site_x"
basin = [-0.5, 0.5]
dividing_surface = 0.5
direction = 1

[recrossing]
parent_replicas = 2
parent_samples = 4
equilibration = "20 fs"
parent_interval = "5 fs"
child_pairs = 2
child_time = "20 fs"
bootstrap = 50

[output]
directory = "runs/materials-site-rate"
checkpoint_interval = "10 fs"
