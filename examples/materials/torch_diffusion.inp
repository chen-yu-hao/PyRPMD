# Short CPU tensor-workflow negative control, not a converged diffusion calculation.
# Run: pyrpmd run examples/materials/torch_diffusion.inp --output runs/torch-diffusion
# Resume: pyrpmd resume runs/torch-diffusion
# Reanalyze: pyrpmd analyze runs/torch-diffusion --recompute --bootstrap 0
# Free-particle motion is ballistic: the analysis should withhold a diffusion constant.
task = "diffusion"
preset = "pilot"
temperature = "300 K"
beads = 8
seed = 1307

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
geometry_unit = "bohr"
cell = [[5.0, 0.0, 0.0], [0.0, 5.0, 0.0], [0.0, 0.0, 5.0]]
cell_unit = "bohr"
pbc = [true, true, true]

[potential]
provider = "free"

[dynamics]
# Sampling uses BCOCB below; production uses this unthermostatted normal-mode map.
integrator = "normal-mode-bab"
timestep = "0.1 fs"
block_steps = 32

[sampling]
engine = "torch"
device = "cpu"
normal_mode_layout = "rpmdrate"
integrator = "bcocb"
thermostat = "pile-l"
gamma_centroid = "0.01 fs^-1"
# An independent real-mass Maxwell draw launches each production replica once.
replicas = 4
equilibration_steps = 20
production_steps = 200
sample_interval = 5

[diffusion]
atom_indices = [0]
axes = [0, 1, 2]
max_lag = 10
fit_range = ["2.5 fs", "5 fs"]
bootstrap = 0

[output]
directory = "runs/torch-diffusion"
trajectory_storage = "stream"
checkpoint_steps = 32
chunk_frames = 8
