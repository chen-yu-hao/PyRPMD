# Langevin centroid diffusion: compare.py checks D=kBT/(m gamma).
task = "diffusion"
temperature = "300 K"
beads = 4
seed = 16504

[system]
symbols = ["H"]
masses = [1837.15264744]
geometry = [[0.0, 0.0, 0.0]]
cell = [[20.0, 0.0, 0.0], [0.0, 20.0, 0.0], [0.0, 0.0, 20.0]]
pbc = [true, true, true]

[potential]
provider = "free"

[dynamics]
timestep = "0.5 fs"
integrator = "cayley-bcb"

[sampling]
thermostat = "pile-l"
equilibration = "500 fs"
production = "10 ps"
interval = "2 fs"
replicas = 8

[electronic_friction]
method = "centroid"
provider = "constant"
gamma = "0.02 fs^-1"

[diffusion]
atom_indices = [0]
axes = [0, 1, 2]
max_lag = 500
fit_range = ["400 fs", "1000 fs"]
bootstrap = 200

[parallel]
backend = "serial"
threads_per_rank = 1

[output]
directory = "run"
checkpoint_interval = "500 fs"
