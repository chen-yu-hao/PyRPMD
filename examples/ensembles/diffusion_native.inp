# Numerical free-particle control; this is not a materials validation.
task = "diffusion"
preset = "pilot"
temperature = "300 K"
beads = 4
seed = 682

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
geometry_unit = "bohr"
cell = [[10.0, 0.0, 0.0], [0.0, 10.0, 0.0], [0.0, 0.0, 10.0]]
cell_unit = "bohr"
pbc = [true, true, true]

[potential]
provider = "free"

[dynamics]
integrator = "cayley-bcb"
loop_backend = "native"
timestep = "0.1 fs"

[sampling]
engine = "native"
thermostat = "pile-l"
equilibration = "4 fs"
production = "20 fs"
interval = "2 fs"
replicas = 1

[diffusion]
atom_indices = [0]
axes = [0, 1, 2]
max_lag = 4
fit_range = ["2 fs", "6 fs"]
bootstrap = 0

[output]
directory = "runs/diffusion-native"
checkpoint_interval = "4 fs"
