# Minimal TS-only input: preparation infers the reaction from the PES Hessian
# and two downhill traces. Defaults are pilot settings, not converged rates.
task = "rate"
preset = "pilot"

[system]
transition_state = "ts.xyz"

[potential]
provider = "python"
factory = "toy_exchange.py:build"

[output]
directory = "runs/minimal"
