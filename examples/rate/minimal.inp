# Deliberately omit [rate.pmf]: legacy umbrella sampling and UI estimation
# remain the defaults; there is no analysis.method to configure.
# Explicitly select the TS-inference convenience mode. For the research layout,
# use research.inp and declare the entrance fragments and forming/breaking bonds.
schema_version = 2
task = "rate"
preset = "pilot"

[system]
transition_state = "ts.xyz"

[potential]
provider = "python"
factory = "toy_exchange.py:build"

[reaction]
definition = "infer"

[preparation]
ts_action = "validate"
check_channel = true

# Explicit RPMDrate-style umbrella coefficient k/T = 0.1;
# dense centers are required for sigma_xi ~= 0.00563.
[umbrella]
start = 0.0
stop = 1.05
count = 211
force_constant = 0.1

[output]
directory = "runs/minimal"
