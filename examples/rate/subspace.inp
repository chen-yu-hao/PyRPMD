# Native rate plus subspace quantum postprocessing below T_c (~363 K), in one .inp.
# pyrpmd run examples/rate/subspace.inp --output runs/rate-with-subspace
# Later, after changing only [rate.subspace_correction.*] controls:
# pyrpmd run examples/rate/subspace.inp --output runs/rate-with-subspace --stage subspace
# Short teaching budgets below do NOT establish physical convergence.
# Research input layout on an analytic TEACHING PES, with short pilot budgets.
# Replace the model and converge beads, timestep, windows and sampling for real work.
schema_version = 2
task = "rate"
preset = "pilot"
temperature = "200 K"
beads = 24
seed = 612

[system]
transition_state = "ts.xyz"

[potential]
provider = "python"
factory = "toy_exchange.py:build"
# Barrier 0.012 Eh (7.5 kcal/mol), T_c ~= 363 K, so 200 K (0.55 T_c) is in the
# tunnelling + corner-cutting regime with C_S(2D) > 2.5 while finishing in < 1 min.
params = { depth = 0.036, alpha = 2.0, equilibrium = 1.2, coupling = 0.144, bending = 0.14 }

[reaction]
definition = "explicit"
reactant_fragments = [[0], [1, 2]]
product_fragments = [[0, 1], [2]]
forming_bonds = [[0, 1]]
breaking_bonds = [[1, 2]]
rinf = "5 angstrom"

[preparation]
ts_action = "refine"    # Refine the analytic guess to the exact saddle of [potential.params].
check_channel = true    # Also compare both downhill sides with the declared channel.

[dynamics]
integrator = "cayley-bcb"
timestep = "0.1 fs"

[parallel]
backend = "process"
trajectory_workers = 4
threads_per_rank = 2

[rate]
# Select xi* from the supported PMF maximum rather than fixing xi=1.0.
pmf_points = 301

# Select reconstruction at the rate boundary, independently of window sampling.
[rate.pmf]
method = "umbrella"
estimator = "ui"

[umbrella]
coordinate = "xi"
# Bare force_constant = k/T; 0.1 gives beta*k ~= 31578 (sigma_xi ~= 0.0056).
force_constant = 0.1

[[umbrella.regions]]
id = "entrance"
start = 0.0
stop = 0.8
spacing = 0.02
include_endpoints = "left"
force_constant = 0.04

[[umbrella.regions]]
id = "barrier"
start = 0.8
stop = 1.12
spacing = 0.01
include_endpoints = "both"
force_constant = 0.1

[umbrella.sampling]
equilibration = "10 fs"
production = "20 fs"
sample_every = "0.2 fs"
chains_per_window = 1

[umbrella.sampling.thermostat]
type = "andersen"
scheme = "global_refresh"
schedule = "fixed"
refresh_every = "2 fs"

[rate.pmf.analysis]
# Estimator is selected by [rate.pmf]; no generic analysis.method required.
# The UI grid is controlled by rate.pmf_points in [rate].
bins = 50
bootstrap_replicates = 10

[recrossing.parent]
chains = 2
equilibration = "10 fs"
draw_every = "1 fs"
configurations_per_chain = 4

[recrossing.parent.thermostat]
type = "andersen"
scheme = "global_refresh"
schedule = "fixed"
refresh_every = "2 fs"

[recrossing.children]
method = "rpmd"
pairs_per_configuration = 2
duration = "10 fs"

[recrossing.analysis]
bootstrap_replicates = 30

[output]
directory = "runs/rate-with-subspace"
checkpoint_interval = "5 fs"


[rate.subspace_correction]
enabled = true
mode = "apply"             # "factor_only" computes C_S without multiplying a full rate
reuse = true               # reuses only content-matched factor records / task checkpoints
dimension = "auto"         # or 1, 2, [1, 2] for a deliberate nested check
environment = "adiabatic"  # use "free_energy" for thermally occupied bath modes
anchor = "skeleton"        # anchors C_S to the 9D Cartesian instanton below T_c
threshold = 0.5            # static MEP kappa*rho ~= 0.52 here -> triggers 1D + 2D check
model_2d = "rph"           # 2D model: reaction-path Hamiltonian on the MEP, or "plane"

[rate.subspace_correction.execution]
cpus = "auto"              # derives from [parallel] (capped by OS CPU affinity)
blas_threads = 4

[rate.subspace_correction.path]
source = "mep"             # default: IRC from the refined saddle; "centroid" = previous default
step = 4.0
asymptote_tolerance = 1e-9
smoothing = 1.5

[rate.subspace_correction.quantum]
spacing_2d = [4.8, 4.2]    # pilot 2D DVR spacing (~2400 retained points, < 15 s solve); refine for convergence
refinement = 3
truncation_kt = 30.0
# At low T (200 K: 30 kT ~= 0.019 Eh), set truncation_min (hartree) to ~6 quanta
# of the stiffest transverse stretch so energy-truncated DVR walls do not squeeze ZPE.
truncation_min = 0.08
product_drop_kt = 22.0
dense_limit = 8000

[rate.subspace_correction.rpmd]
# Temperature and beads are inherited from the rate run. These are independent
# subspace HMC/TI/recrossing budgets, not the full-system sampling budget.
windows = 32
walkers = 24
burn_in = 100
sweeps = 300
trajectories = 384
# 900 a.u. (~21.8 fs ~= 6.5 / omega_b) plateaus kappa(t) well inside the subspace grid.
md_time = 900.0
seed = 17
