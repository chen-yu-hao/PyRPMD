# Native rate plus optional subspace quantum postprocessing, in one .inp.
# pyrpmd run examples/rate/subspace.inp
# Later, after changing only the subspace controls:
# pyrpmd run examples/rate/subspace.inp --stage subspace
# Short teaching budgets below do NOT establish physical convergence.
# Research input layout on an analytic TEACHING PES, with short pilot budgets.
# Replace the model and converge beads, timestep, windows and sampling for real work.
schema_version = 2
task = "rate"
preset = "pilot"
temperature = "1000 K"
beads = 4
seed = 612

[system]
transition_state = "ts.xyz"

[potential]
provider = "python"
factory = "toy_exchange.py:build"

[reaction]
definition = "explicit"
reactant_fragments = [[0], [1, 2]]
product_fragments = [[0, 1], [2]]
forming_bonds = [[0, 1]]
breaking_bonds = [[1, 2]]
rinf = "5 angstrom"

[preparation]
ts_action = "validate"  # Check the supplied saddle without moving its coordinates.
check_channel = true    # Also compare both downhill sides with the declared channel.

[dynamics]
integrator = "cayley-bcb"
timestep = "0.1 fs"

[rate]
# Select xi* from the supported PMF maximum rather than fixing xi=1.0.
pmf_points = 401

# Select reconstruction at the rate boundary, independently of window sampling.
[rate.pmf]
method = "umbrella"
estimator = "ui"

[umbrella]
coordinate = "xi"
# Bare force_constant = k/T; 0.1 matches the RPMDrate H+H2 example.
# Here k = 0.1 * 1000 = 100 hartree (RPMDrate H+H2 convention).
force_constant = 0.1

[[umbrella.regions]]
id = "entrance"
start = 0.0
stop = 0.8
spacing = 0.005
include_endpoints = "left"

[[umbrella.regions]]
id = "barrier"
start = 0.8
stop = 1.05
spacing = 0.005
include_endpoints = "both"
force_constant = 0.1

[umbrella.sampling]
equilibration = "5 fs"
production = "20 fs"
sample_every = "0.2 fs"
chains_per_window = 1

[umbrella.sampling.thermostat]
type = "andersen"
scheme = "global_refresh"
schedule = "fixed"
refresh_every = "2 fs"

[rate.pmf.analysis]
# Estimator is selected by [rate.pmf]; no generic analysis.method required.
# The UI grid is controlled by rate.pmf_points in [rate].
bins = 50
bootstrap_replicates = 10

[recrossing.parent]
chains = 2
equilibration = "5 fs"
draw_every = "1 fs"
configurations_per_chain = 4

[recrossing.parent.thermostat]
type = "andersen"
scheme = "global_refresh"
schedule = "fixed"
refresh_every = "2 fs"

[recrossing.children]
method = "rpmd"
pairs_per_configuration = 2
duration = "10 fs"

[recrossing.analysis]
bootstrap_replicates = 30

[output]
directory = "runs/rate-with-subspace"
checkpoint_interval = "5 fs"


[rate.subspace_correction]
enabled = true
mode = "apply"             # "factor_only" computes C_S without multiplying a full rate
reuse = true               # reuses only content-matched factor records
dimension = "auto"         # or 1, 2, [1, 2] for a deliberate nested check
environment = "adiabatic"  # use "free_energy" for thermally occupied bath modes
threshold = 0.5
model_2d = "rph"           # 2D model: reaction-path Hamiltonian on the MEP, or "plane"

[rate.subspace_correction.path]
source = "mep"             # default: IRC from the refined saddle; "centroid" = previous default
step = 10.0
smoothing = 1.5

[rate.subspace_correction.quantum]
refinement = 3
truncation_kt = 30.0
# At low T, also converge truncation_min (hartree); 30 kT can be too small.
dense_limit = 8000

[rate.subspace_correction.rpmd]
# Temperature and beads are inherited from the rate run. These are independent
# subspace HMC/TI/recrossing budgets, not the full-system sampling budget.
walkers = 32
sweeps = 400
trajectories = 512
seed = 17
