# First PyRPMD calculation: centroid free energy of one H nucleus in a harmonic well.
# The centroid density of a harmonic oscillator is classical for any bead number, so
# the exact answer is F(x) = k x^2 / 2. A few seconds of sampling reproduces it to
# about 0.1 kBT; see the Quickstart chapter for the comparison.
schema_version = 1
task = "fes"
preset = "pilot"
temperature = "300 K"
beads = 4
seed = 20261030

[system]
symbols = ["H"]
geometry = [[0.0, 0.0, 0.0]]
geometry_unit = "bohr"

[potential]
provider = "harmonic"
params = {k = 0.002}

[dynamics]
integrator = "cayley-bcb"
timestep = "0.5 fs"

[sampling]
equilibration_steps = 1000   # 0.5 ps per stream, discarded
production_steps = 50000     # 25 ps per stream
sample_interval = 25         # one saved sample every 12.5 fs
andersen_interval = 50       # momenta resampled every 25 fs
replicas = 2

[[cvs]]
name = "x"
kind = "cartesian"
atom = 0
axis = "x"
estimator = "centroid"
unit = "bohr"

[umbrella]
cvs = ["x"]
centers = [-1.0, -0.5, 0.0, 0.5, 1.0]
stiffness = "0.004 hartree/bohr^2"

[analysis]
bins = 12
ranges = [[-1.5, 1.5]]
bootstrap = 20
min_count = 20

[output]
directory = "run"
checkpoint_steps = 10000
